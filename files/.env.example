# ─── بيانات الصندوق البنكية ──────────────────────
FUND_BANK_ACCOUNT=SA12 3456 7890 1234 5678 90
FUND_BANK_NAME=صندوق عائلة قطيفان — بنك الراجحي

# ─── إعدادات الأعمال ────────────────────────────
FUND_RESERVE_RATIO=0.10        # 10% احتياطي — لا يُصرف دونه إلا بإذن صريح
RECONCILE_TOLERANCE=1.00       # فارق مقبول في المطابقة (ريال)
LOG_LEVEL=info
NODE_ENV=production
